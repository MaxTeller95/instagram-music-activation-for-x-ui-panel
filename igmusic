#!/usr/bin/env python3
"""
igmusic - Instagram Music Activation for x-ui panel
====================================================

Instagram hides the "Music" sticker when it sees your connection coming from a
datacenter / VPN IP, or from a region without music licensing. If your x-ui
server exits through a datacenter IP (a normal VPS, Cloudflare WARP, etc.),
the music icon disappears - even though everything else works.

This tool fixes that WITHOUT sending your whole Instagram traffic through an
expensive residential proxy. It routes ONLY the tiny Instagram region-check API
(`i.instagram.com`) through a residential SOCKS outbound you add to x-ui, for a
few minutes on a schedule. Instagram registers your account's region as the
residential IP's country (where music is licensed) and caches it server-side for
~1.5-2 hours, so the music icon stays available continuously - while every heavy
byte (reels, photos, video, even the music audio) keeps flowing through your
normal, free exit.

    app  --->  x-ui  --->  i.instagram.com   (region check)  -> residential  [tiny, periodic]
                      \->  everything else                    -> your normal exit  [free]

PREREQUISITE
------------
In the x-ui panel add an OUTBOUND:
    Protocol : socks
    Tag      : residental
    Address / Port / user / pass : your residential proxy in a music-enabled country
Then run:  sudo igmusic install

Commands:  check | install | refresh | on | off | status | uninstall
Only the `residental` routing rule is ever touched; all your other routing and
the panel version stay exactly as they are. Every change backs up x-ui.db first.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

APP = "igmusic"
CONF_DIR = "/etc/igmusic"
CONF = os.path.join(CONF_DIR, "config.json")
BACKUPS = os.path.join(CONF_DIR, "backups")
SERVICE = "/etc/systemd/system/igmusic-refresh.service"
TIMER = "/etc/systemd/system/igmusic-refresh.timer"
TEMPLATE_KEY = "xrayTemplateConfig"

DEFAULTS = {
    "xui_db": "",                       # auto-detected when empty
    "outbound_tag": "residental",
    "hosts": ["full:i.instagram.com"],  # the region-check API; keep it minimal to save data
    "interval_min": 90,                 # < Instagram's ~1.5-2h region cache
    "window_sec": 300,                  # how long the route stays on per refresh
}

# ------------------------------------------------------------------ output --
_TTY = sys.stdout.isatty()
def _c(code, s): return f"\033[{code}m{s}\033[0m" if _TTY else s
def ok(s):   print(_c("32", "[ok] ") + s)
def info(s): print(_c("36", "[*]  ") + s)
def warn(s): print(_c("33", "[!]  ") + s)
def err(s):  print(_c("31", "[x]  ") + s, file=sys.stderr)
def die(s, code=1): err(s); sys.exit(code)


def need_root():
    if os.geteuid() != 0:
        die("run as root (sudo igmusic ...)")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


# ----------------------------------------------------------- x-ui plumbing --
def find_db(cfg):
    if cfg.get("xui_db") and os.path.exists(cfg["xui_db"]):
        return cfg["xui_db"]
    for p in ("/etc/x-ui/x-ui.db", "/usr/local/x-ui/x-ui.db", "/opt/x-ui/x-ui.db"):
        if os.path.exists(p):
            return p
    die("x-ui database not found (looked in /etc/x-ui, /usr/local/x-ui). Is x-ui installed?")


def find_xray():
    for p in ("/usr/local/x-ui/bin/xray-linux-amd64", "/usr/local/x-ui/bin/xray"):
        if os.path.exists(p):
            return p
    hits = glob.glob("/usr/local/x-ui/bin/xray*")
    return hits[0] if hits else None


def xray_asset_dir():
    return "/usr/local/x-ui/bin"


def running_config():
    for p in ("/usr/local/x-ui/bin/config.json", "/usr/local/x-ui/config.json"):
        if os.path.exists(p):
            return p
    return None


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONF):
        try:
            cfg.update(json.load(open(CONF)))
        except Exception:
            warn(f"{CONF} unreadable, using defaults")
    cfg["xui_db"] = find_db(cfg)
    return cfg


def save_config(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    json.dump(cfg, open(CONF, "w"), indent=2)


def backup_db(db):
    os.makedirs(BACKUPS, exist_ok=True)
    os.chmod(BACKUPS, 0o700)
    dst = os.path.join(BACKUPS, "x-ui-%s.db" % time.strftime("%Y%m%d-%H%M%S"))
    s = sqlite3.connect(db)
    d = sqlite3.connect(dst)
    s.backup(d)
    d.close()
    s.close()
    keep = sorted(glob.glob(os.path.join(BACKUPS, "x-ui-*.db")))
    for old in keep[:-10]:
        os.remove(old)
    return dst


def read_template(db):
    con = sqlite3.connect(db)
    row = con.execute("SELECT value FROM settings WHERE key=?", (TEMPLATE_KEY,)).fetchone()
    con.close()
    if not row:
        die("this x-ui has no xrayTemplateConfig (unexpected panel build)")
    return json.loads(row[0])


def write_template(db, tpl):
    con = sqlite3.connect(db)
    con.execute("UPDATE settings SET value=? WHERE key=?",
                (json.dumps(tpl, ensure_ascii=False), TEMPLATE_KEY))
    con.commit()
    con.close()


def get_outbound(tpl, tag):
    return next((o for o in tpl.get("outbounds", []) if o.get("tag") == tag), None)


def restart_xui():
    run(["systemctl", "restart", "x-ui"])
    for _ in range(40):
        if run(["pgrep", "-f", "xray-linux-amd64 -c"]).returncode == 0:
            break
        time.sleep(1)
    time.sleep(2)


def set_route(cfg, on: bool):
    """Add or remove the single `residental` routing rule; leave everything else intact."""
    db = cfg["xui_db"]
    tag = cfg["outbound_tag"]
    tpl = read_template(db)
    if not get_outbound(tpl, tag):
        die(f"no outbound tagged '{tag}' in the panel. Add a SOCKS outbound with that tag first "
            f"(see `igmusic check`).")
    rules = [r for r in tpl["routing"].get("rules", []) if r.get("outboundTag") != tag]
    if on:
        # first field-rule so these hosts win over any later instagram/catch-all rule
        rules.insert(0, {"type": "field", "outboundTag": tag, "domain": list(cfg["hosts"])})
    tpl["routing"]["rules"] = rules
    backup_db(db)
    write_template(db, tpl)
    restart_xui()


def route_is_on(cfg):
    rc = running_config()
    if not rc:
        return None
    try:
        d = json.load(open(rc))
    except Exception:
        return None
    return any(r.get("outboundTag") == cfg["outbound_tag"] for r in d.get("routing", {}).get("rules", []))


# ------------------------------------------------------- residential check --
DATACENTER_HINTS = ("datacamp", "m247", "ovh", "hetzner", "amazon", "aws", "google",
                    "cloud", "digitalocean", "linode", "vultr", "leaseweb", "contabo",
                    "choopa", "hosting", "server", "colo", "webshare-datacenter")
MUSIC_COUNTRIES = {  # Instagram music is broadly licensed in these; not exhaustive
    "US", "GB", "DE", "FR", "IT", "ES", "NL", "SE", "CA", "AU", "BR", "MX", "JP",
    "KR", "IN", "TR", "AE", "SA", "PL", "PT", "IE", "BE", "AT", "CH", "DK", "NO", "FI",
}


def check_proxy(cfg):
    """Spin a throwaway xray on the residential outbound and report egress ip/country/type."""
    db = cfg["xui_db"]
    tag = cfg["outbound_tag"]
    xray = find_xray()
    if not xray:
        warn("xray binary not found; skipping live proxy test")
        return None
    tpl = read_template(db)
    out = get_outbound(tpl, tag)
    if not out:
        return None
    W = tempfile.mkdtemp(prefix="igmusic-chk-")
    try:
        conf = {
            "log": {"loglevel": "warning"},
            "inbounds": [{"listen": "127.0.0.1", "port": 13939, "protocol": "socks",
                          "settings": {"udp": True}}],
            "outbounds": [dict(out, tag="out")],
        }
        cf = os.path.join(W, "c.json")
        json.dump(conf, open(cf, "w"))
        p = subprocess.Popen([xray, "run", "-c", cf],
                             env=dict(os.environ, XRAY_LOCATION_ASSET=xray_asset_dir()),
                             stdout=open(os.path.join(W, "log"), "w"), stderr=subprocess.STDOUT)
        time.sleep(4)

        def curl(url, extra=None, tmo="20"):
            return run(["curl", "-s", "-m", tmo, "--socks5-hostname", "127.0.0.1:13939"]
                       + (extra or []) + [url]).stdout
        ipinfo = curl("https://ipinfo.io/json")
        ig = curl("https://i.instagram.com/", ["-o", "/dev/null", "-w", "%{http_code}"], "15")
        p.terminate()
        p.wait()
        try:
            j = json.loads(ipinfo)
        except Exception:
            return {"ok": False}
        org = (j.get("org") or "").lower()
        return {
            "ok": bool(j.get("ip")),
            "ip": j.get("ip"), "country": j.get("country"), "org": j.get("org"),
            "datacenter": any(h in org for h in DATACENTER_HINTS),
            "music_country": (j.get("country") or "").upper() in MUSIC_COUNTRIES,
            "ig_reachable": ig in ("200", "302", "400", "404"),
        }
    finally:
        shutil.rmtree(W, ignore_errors=True)


# --------------------------------------------------------------- commands ---
def cmd_check(cfg, _):
    info(f"x-ui database : {cfg['xui_db']}")
    tpl = read_template(cfg["xui_db"])
    out = get_outbound(tpl, cfg["outbound_tag"])
    if not out:
        err(f"no outbound tagged '{cfg['outbound_tag']}' found.")
        print("\n  Add it in the x-ui panel:")
        print("    Xray Settings -> Outbounds -> + -> Protocol: socks")
        print(f"    Tag: {cfg['outbound_tag']}")
        print("    Address / Port / Username / Password: your RESIDENTIAL proxy")
        print("  then run `igmusic check` again.\n")
        sys.exit(2)
    ok(f"found outbound '{cfg['outbound_tag']}' (protocol {out.get('protocol')})")
    info("testing the residential proxy (egress) ...")
    r = check_proxy(cfg)
    if not r or not r.get("ok"):
        die("could not reach the internet through the residential outbound - check its credentials.")
    line = f"egress {r['ip']}  country={r['country']}  org={r['org']}"
    ok(line) if r["ig_reachable"] else warn(line)
    if r["datacenter"]:
        warn("this looks like a DATACENTER IP - Instagram may still hide music. A true residential IP works best.")
    else:
        ok("looks residential (not an obvious datacenter ASN)")
    if not r["music_country"]:
        warn(f"country {r['country']} may not have Instagram music licensing - pick a proxy in US/GB/DE/... ")
    else:
        ok(f"{r['country']} is a music-licensed region")
    print()
    info("ready. run `sudo igmusic install` to enable automatic activation.")


def _write_units(cfg):
    interval = int(cfg["interval_min"])
    open(SERVICE, "w").write(
        "[Unit]\n"
        "Description=Instagram music region refresh (igmusic)\n"
        "After=x-ui.service\nWants=x-ui.service\n\n"
        "[Service]\nType=oneshot\n"
        "ExecStart=/usr/local/sbin/igmusic refresh\n"
        "TimeoutStartSec=900\n")
    open(TIMER, "w").write(
        "[Unit]\n"
        "Description=Run igmusic Instagram-music refresh every %d min\n\n" % interval +
        "[Timer]\n"
        "OnBootSec=3min\n"
        "OnUnitActiveSec=%dmin\n" % interval +
        "AccuracySec=1min\nPersistent=true\n\n"
        "[Install]\nWantedBy=timers.target\n")


def cmd_install(cfg, args):
    need_root()
    if args.interval:
        cfg["interval_min"] = args.interval
    if args.window:
        cfg["window_sec"] = args.window
    if args.tag:
        cfg["outbound_tag"] = args.tag
    tpl = read_template(cfg["xui_db"])
    if not get_outbound(tpl, cfg["outbound_tag"]):
        die(f"no outbound tagged '{cfg['outbound_tag']}'. Add it in the panel, then rerun. (`igmusic check`)")
    save_config(cfg)
    _write_units(cfg)
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "igmusic-refresh.timer"])
    ok(f"installed. refresh every {cfg['interval_min']} min, {cfg['window_sec']}s window per refresh.")
    info("doing a first activation now ...")
    cmd_refresh(cfg, args)
    ok("done. open Instagram (close & reopen) - the Music sticker should be back.")


def cmd_refresh(cfg, _):
    need_root()
    info("region refresh: routing %s through '%s' ..." % (", ".join(cfg["hosts"]), cfg["outbound_tag"]))
    set_route(cfg, True)
    time.sleep(int(cfg["window_sec"]))
    set_route(cfg, False)
    ok("refresh cycle complete (residential route off again).")


def cmd_on(cfg, _):
    need_root()
    set_route(cfg, True)
    ok(f"'{cfg['outbound_tag']}' route ON for {', '.join(cfg['hosts'])} (stays on until `igmusic off`).")


def cmd_off(cfg, _):
    need_root()
    set_route(cfg, False)
    ok("residential route OFF (all Instagram on the normal exit).")


def _residential_bytes(cfg):
    rc = running_config()
    xray = find_xray()
    if not rc or not xray:
        return None
    try:
        api = next(i for i in json.load(open(rc))["inbounds"] if i.get("tag") == "api")
        port = api["port"]
    except Exception:
        return None
    out = run([xray, "api", "statsquery", "--server=127.0.0.1:%s" % port, "-pattern", cfg["outbound_tag"]]).stdout
    try:
        tot = 0
        for s in json.loads(out).get("stat", []):
            if s.get("name", "").startswith("outbound>>>%s>>>" % cfg["outbound_tag"]):
                tot += int(s.get("value", 0))
        return tot
    except Exception:
        return None


def cmd_status(cfg, _):
    on = route_is_on(cfg)
    info("residential route : " + ("ON" if on else "OFF" if on is not None else "unknown"))
    info("outbound tag      : " + cfg["outbound_tag"])
    info("hosts             : " + ", ".join(cfg["hosts"]))
    info("interval / window : %s min / %s s" % (cfg["interval_min"], cfg["window_sec"]))
    t = run(["systemctl", "is-active", "igmusic-refresh.timer"]).stdout.strip()
    info("refresh timer     : " + t)
    nxt = run(["systemctl", "show", "igmusic-refresh.timer", "-p", "NextElapseUSecRealtime", "--value"]).stdout.strip()
    if nxt:
        info("next refresh      : " + nxt)
    b = _residential_bytes(cfg)
    if b is not None:
        info("residential used  : %.1f MB (since last xray restart)" % (b / 1048576))


def cmd_uninstall(cfg, _):
    need_root()
    run(["systemctl", "disable", "--now", "igmusic-refresh.timer"])
    for f in (SERVICE, TIMER):
        if os.path.exists(f):
            os.remove(f)
    run(["systemctl", "daemon-reload"])
    set_route(cfg, False)
    ok("uninstalled: timer removed, residential route off, all Instagram on the normal exit.")
    info("your `residental` outbound and x-ui config are untouched. Backups kept in " + BACKUPS)


def main():
    ap = argparse.ArgumentParser(prog=APP, description="Instagram Music Activation for x-ui panel")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("check", help="verify x-ui + the residential outbound, test its egress")
    pi = sub.add_parser("install", help="enable automatic activation (systemd timer)")
    pi.add_argument("--interval", type=int, help="minutes between refreshes (default 90)")
    pi.add_argument("--window", type=int, help="seconds the route stays on per refresh (default 300)")
    pi.add_argument("--tag", help="outbound tag to use (default: residental)")
    sub.add_parser("refresh", help="run one refresh cycle now (used by the timer)")
    sub.add_parser("on", help="route Instagram API through residential and leave it on")
    sub.add_parser("off", help="send Instagram back to the normal exit")
    sub.add_parser("status", help="show route/timer/usage")
    sub.add_parser("uninstall", help="remove the timer and turn the route off")
    args = ap.parse_args()
    if not args.cmd:
        ap.print_help()
        sys.exit(0)
    cfg = load_config()
    {
        "check": cmd_check, "install": cmd_install, "refresh": cmd_refresh,
        "on": cmd_on, "off": cmd_off, "status": cmd_status, "uninstall": cmd_uninstall,
    }[args.cmd](cfg, args)


if __name__ == "__main__":
    main()
