#!/usr/bin/env python3
"""
igmusic - Instagram Music Activation for x-ui panel
====================================================

Instagram decides whether the "Music" sticker is available from the IP of your
app's calls to `i.instagram.com` (its main private API). If your x-ui server
exits through a datacenter / VPN IP, or a region without music licensing, the
music icon disappears even though everything else works.

This tool permanently routes ONLY the Instagram region-check API hosts
(`i.instagram.com`, `b.i.instagram.com`) through an outbound you add to x-ui -
an outbound whose egress IP is in the US (or any Instagram-music country).
Instagram then registers your account's region from that IP and the music
sticker stays. Everything else - reels, photos, video, even the music audio -
keeps using your normal, free exit.

    app -> x-ui -> i.instagram.com / b.i.instagram.com  -> IGMUSIC outbound (US IP)
                \> everything else                        -> your normal exit  (free)

It is a single, STATIC routing rule: no timer, no refresh, no watcher, no restart
loops. x-ui.db is backed up before the change and nothing else in your panel is
touched.

PREREQUISITE
------------
In the x-ui panel add an OUTBOUND whose egress IP is in the US (or another
Instagram-music country). It can be ANY protocol your panel supports - a
SOCKS/HTTP residential proxy, VLESS / VMess / Trojan / Shadowsocks to a US
server, WireGuard, etc. - the only thing that matters is that its exit IP is a
US IP. Give the outbound the tag:

    IGMUSIC

Then run:  sudo igmusic install

Commands: check | install | uninstall | status
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

APP = "igmusic"
CONF_DIR = "/etc/igmusic"
CONF = os.path.join(CONF_DIR, "config.json")
BACKUPS = os.path.join(CONF_DIR, "backups")
TEMPLATE_KEY = "xrayTemplateConfig"
RULE_TAG = "igmusic"                    # so the rules can be found again, whoever wrote them
QUIC_TAG = "igmusic-quic-block"

DEFAULTS = {
    "xui_db": "",                       # auto-detected when empty
    "outbound_tag": "IGMUSIC",          # the US-IP outbound you added in the panel
    # Instagram reads your region from these API hosts; the heavy media (cdninstagram)
    # is deliberately NOT here, so it keeps using your free exit.
    #   i.instagram.com / b.i.instagram.com - the region check, which gates the music
    #     sticker on YOUR stories
    #   graph.instagram.com - the music metadata for OTHER people's stories. Without it
    #     the sticker comes back but their stories still say "Audio unavailable".
    "hosts": ["full:i.instagram.com", "full:b.i.instagram.com", "full:graph.instagram.com"],
    # A SOCKS proxy usually cannot carry UDP, so the app's HTTP/3 calls would go around
    # the outbound and the region check would leak your real exit. Blocking QUIC for
    # these hosts makes the app fall back to TCP, which the outbound does carry.
    "block_quic": True,
}

_TTY = sys.stdout.isatty()
def _c(code, s): return f"\033[{code}m{s}\033[0m" if _TTY else s
def ok(s):   print(_c("32", "[ok] ") + s)
def info(s): print(_c("36", "[*]  ") + s)
def warn(s): print(_c("33", "[!]  ") + s)
def err(s):  print(_c("31", "[x]  ") + s, file=sys.stderr)
def die(s, code=1): err(s); sys.exit(code)


def need_root():
    if os.geteuid() != 0:
        die("run as root (sudo igmusic ...)")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


# ----------------------------------------------------------- x-ui plumbing --
def find_db(cfg):
    if cfg.get("xui_db") and os.path.exists(cfg["xui_db"]):
        return cfg["xui_db"]
    for p in ("/etc/x-ui/x-ui.db", "/usr/local/x-ui/x-ui.db", "/opt/x-ui/x-ui.db"):
        if os.path.exists(p):
            return p
    die("x-ui database not found (looked in /etc/x-ui, /usr/local/x-ui). Is x-ui installed?")


def find_xray():
    for p in ("/usr/local/x-ui/bin/xray-linux-amd64", "/usr/local/x-ui/bin/xray"):
        if os.path.exists(p):
            return p
    hits = glob.glob("/usr/local/x-ui/bin/xray*")
    return hits[0] if hits else None


def running_config():
    for p in ("/usr/local/x-ui/bin/config.json", "/usr/local/x-ui/config.json"):
        if os.path.exists(p):
            return p
    return None


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONF):
        try:
            cfg.update(json.load(open(CONF)))
        except Exception:
            warn(f"{CONF} unreadable, using defaults")
    cfg["xui_db"] = find_db(cfg)
    return cfg


def save_config(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    json.dump(cfg, open(CONF, "w"), indent=2)


def backup_db(db):
    os.makedirs(BACKUPS, exist_ok=True)
    os.chmod(BACKUPS, 0o700)
    dst = os.path.join(BACKUPS, "x-ui-%s.db" % time.strftime("%Y%m%d-%H%M%S"))
    s = sqlite3.connect(db); d = sqlite3.connect(dst); s.backup(d); d.close(); s.close()
    for old in sorted(glob.glob(os.path.join(BACKUPS, "x-ui-*.db")))[:-10]:
        os.remove(old)
    return dst


def read_template(db):
    con = sqlite3.connect(db)
    row = con.execute("SELECT value FROM settings WHERE key=?", (TEMPLATE_KEY,)).fetchone()
    con.close()
    if not row:
        die("this x-ui has no xrayTemplateConfig (unexpected panel build)")
    return json.loads(row[0])


def write_template(db, tpl):
    con = sqlite3.connect(db)
    con.execute("UPDATE settings SET value=? WHERE key=?",
                (json.dumps(tpl, ensure_ascii=False), TEMPLATE_KEY))
    con.commit(); con.close()


def get_outbound(tpl, tag):
    return next((o for o in tpl.get("outbounds", []) if o.get("tag") == tag), None)


def restart_xui():
    run(["systemctl", "restart", "x-ui"])
    for _ in range(40):
        if run(["pgrep", "-f", "xray-linux-amd64 -c"]).returncode == 0:
            break
        time.sleep(1)
    time.sleep(2)


def set_route(cfg, on: bool):
    """Add or remove the single static rule that sends the region-check hosts to the outbound."""
    db = cfg["xui_db"]; tag = cfg["outbound_tag"]
    tpl = read_template(db)
    if on and not get_outbound(tpl, tag):
        die(f"no outbound tagged '{tag}' in the panel. Add a US-IP outbound with that tag first "
            f"(see `igmusic check`).")
    rules = [r for r in tpl["routing"].get("rules", [])
             if r.get("outboundTag") != tag and r.get("ruleTag") != QUIC_TAG]
    if on:
        rules.insert(0, {"type": "field", "ruleTag": RULE_TAG, "outboundTag": tag,
                         "domain": list(cfg["hosts"])})
        if cfg.get("block_quic", True):
            hole = next((o.get("tag") for o in tpl.get("outbounds", [])
                         if o.get("protocol") == "blackhole" and o.get("tag")), None)
            if hole:
                # first, so the UDP half never reaches the rule above
                rules.insert(0, {"type": "field", "ruleTag": QUIC_TAG, "outboundTag": hole,
                                 "network": "udp", "domain": list(cfg["hosts"])})
            else:
                warn("no blackhole outbound in the panel - QUIC is not blocked, so an app "
                     "speaking HTTP/3 can slip past the outbound")
    tpl["routing"]["rules"] = rules
    backup_db(db)
    write_template(db, tpl)
    restart_xui()


def route_is_on(cfg):
    rc = running_config()
    if not rc:
        return None
    try:
        d = json.load(open(rc))
    except Exception:
        return None
    return any(r.get("outboundTag") == cfg["outbound_tag"] for r in d.get("routing", {}).get("rules", []))


# ------------------------------------------------------- outbound egress check --
DATACENTER_HINTS = ("datacamp", "m247", "ovh", "hetzner", "amazon", "aws", "google",
                    "cloud", "digitalocean", "linode", "vultr", "leaseweb", "contabo",
                    "choopa", "hosting", "colo")
MUSIC_COUNTRIES = {"US", "GB", "DE", "FR", "IT", "ES", "NL", "SE", "CA", "AU", "BR", "MX",
                   "JP", "KR", "IN", "TR", "AE", "SA", "PL", "PT", "IE", "BE", "AT", "CH",
                   "DK", "NO", "FI"}


def check_proxy(cfg):
    """Spin a throwaway xray on the outbound (any protocol) and report its egress ip/country."""
    db = cfg["xui_db"]; tag = cfg["outbound_tag"]
    xray = find_xray()
    if not xray:
        warn("xray binary not found; skipping live egress test")
        return None
    out = get_outbound(read_template(db), tag)
    if not out:
        return None
    W = tempfile.mkdtemp(prefix="igmusic-chk-")
    try:
        conf = {"log": {"loglevel": "warning"},
                "inbounds": [{"listen": "127.0.0.1", "port": 13939, "protocol": "socks",
                              "settings": {"udp": True}}],
                "outbounds": [dict(out, tag="out")]}
        cf = os.path.join(W, "c.json"); json.dump(conf, open(cf, "w"))
        p = subprocess.Popen([xray, "run", "-c", cf],
                             env=dict(os.environ, XRAY_LOCATION_ASSET="/usr/local/x-ui/bin"),
                             stdout=open(os.path.join(W, "log"), "w"), stderr=subprocess.STDOUT)
        time.sleep(4)
        def curl(url, extra=None, tmo="20"):
            return run(["curl", "-s", "-m", tmo, "--socks5-hostname", "127.0.0.1:13939"]
                       + (extra or []) + [url]).stdout
        ipinfo = curl("https://ipinfo.io/json")
        ig = curl("https://i.instagram.com/", ["-o", "/dev/null", "-w", "%{http_code}"], "15")
        p.terminate(); p.wait()
        try:
            j = json.loads(ipinfo)
        except Exception:
            return {"ok": False}
        org = (j.get("org") or "").lower()
        return {"ok": bool(j.get("ip")), "ip": j.get("ip"), "country": j.get("country"),
                "org": j.get("org"), "datacenter": any(h in org for h in DATACENTER_HINTS),
                "music_country": (j.get("country") or "").upper() in MUSIC_COUNTRIES,
                "ig_reachable": ig in ("200", "302", "400", "404")}
    finally:
        shutil.rmtree(W, ignore_errors=True)


# --------------------------------------------------------------- commands ---
def cmd_check(cfg, _):
    info(f"x-ui database : {cfg['xui_db']}")
    out = get_outbound(read_template(cfg["xui_db"]), cfg["outbound_tag"])
    if not out:
        err(f"no outbound tagged '{cfg['outbound_tag']}' found.")
        print("\n  Add it in the x-ui panel (Xray Settings -> Outbounds -> +).")
        print("  It can be ANY protocol the panel supports (socks/http proxy, vless, vmess,")
        print("  trojan, shadowsocks, wireguard, ...) as long as its egress IP is a US IP.")
        print(f"  Give it the tag:  {cfg['outbound_tag']}")
        print("  then run `igmusic check` again.\n")
        sys.exit(2)
    ok(f"found outbound '{cfg['outbound_tag']}' (protocol {out.get('protocol')})")
    info("testing the outbound egress ...")
    r = check_proxy(cfg)
    if not r or not r.get("ok"):
        die("could not reach the internet through the outbound - check its settings.")
    line = f"egress {r['ip']}  country={r['country']}  org={r['org']}"
    ok(line) if r["ig_reachable"] else warn(line)
    (ok if r["music_country"] else warn)(
        f"{r['country']} is a music-licensed region" if r["music_country"]
        else f"country {r['country']} may not have Instagram music - use a US IP (or GB/DE/...).")
    if r["datacenter"]:
        warn("egress looks like a DATACENTER IP - a residential/mobile US IP is more reliable for music.")
    print()
    info("ready. run `sudo igmusic install` to route Instagram's region check through it.")


def cmd_install(cfg, args):
    need_root()
    if args.tag:
        cfg["outbound_tag"] = args.tag
    if not get_outbound(read_template(cfg["xui_db"]), cfg["outbound_tag"]):
        die(f"no outbound tagged '{cfg['outbound_tag']}'. Add a US-IP outbound with that tag first "
            f"(`igmusic check`).")
    save_config(cfg)
    info("adding static rule: %s -> '%s' ..." % (", ".join(cfg["hosts"]), cfg["outbound_tag"]))
    set_route(cfg, True)
    ok("done - Instagram's region check now goes through '%s' permanently." % cfg["outbound_tag"])
    ok("open Instagram (close & reopen); the Music sticker should be back and stay.")


def cmd_uninstall(cfg, _):
    need_root()
    set_route(cfg, False)
    ok("removed: Instagram region check is back on the normal exit.")
    info("your '%s' outbound and the rest of x-ui are untouched. Backups in %s" % (cfg["outbound_tag"], BACKUPS))


def _outbound_bytes(cfg):
    rc = running_config(); xray = find_xray()
    if not rc or not xray:
        return None
    try:
        port = next(i for i in json.load(open(rc))["inbounds"] if i.get("tag") == "api")["port"]
    except Exception:
        return None
    out = run([xray, "api", "statsquery", "--server=127.0.0.1:%s" % port, "-pattern", cfg["outbound_tag"]]).stdout
    try:
        return sum(int(s.get("value", 0)) for s in json.loads(out).get("stat", [])
                   if s.get("name", "").startswith("outbound>>>%s>>>" % cfg["outbound_tag"]))
    except Exception:
        return None


def cmd_status(cfg, _):
    on = route_is_on(cfg)
    info("outbound tag      : " + cfg["outbound_tag"])
    info("region hosts      : " + ", ".join(cfg["hosts"]))
    info("static route      : " + ("ON (Instagram region check -> %s)" % cfg["outbound_tag"] if on
                                    else "OFF (on the normal exit)" if on is not None else "unknown"))
    b = _outbound_bytes(cfg)
    if b is not None:
        info("outbound used     : %.1f MB (since last xray restart)" % (b / 1048576))


def main():
    ap = argparse.ArgumentParser(prog=APP, description="Instagram Music Activation for x-ui panel (static)")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("check", help="verify x-ui + the outbound, test its egress IP/country")
    pi = sub.add_parser("install", help="add the static rule (region check -> the outbound)")
    pi.add_argument("--tag", help="outbound tag to use (default: IGMUSIC)")
    sub.add_parser("uninstall", help="remove the rule (Instagram back on the normal exit)")
    sub.add_parser("status", help="show the static route state and outbound usage")
    args = ap.parse_args()
    if not args.cmd:
        ap.print_help(); sys.exit(0)
    cfg = load_config()
    {"check": cmd_check, "install": cmd_install, "uninstall": cmd_uninstall,
     "status": cmd_status}[args.cmd](cfg, args)


if __name__ == "__main__":
    main()
