#!/usr/bin/env python3
"""
igmusic - Instagram Music Activation for x-ui panel
====================================================

Instagram hides the "Music" sticker when it sees your connection coming from a
datacenter / VPN IP, or from a region without music licensing. If your x-ui
server exits through such an IP, the music icon disappears even though everything
else works.

This tool fixes that WITHOUT sending all your Instagram traffic through an
expensive residential proxy. It routes ONLY the tiny Instagram region-check API
(`i.instagram.com`) through a residential SOCKS outbound you add to x-ui, and
only for a few minutes when it's actually needed. Instagram registers your
account's region as the residential IP's country and caches it server-side for a
while, so the music icon stays visible - while every heavy byte (reels, photos,
video, even the music audio) keeps flowing through your normal, free exit.

    app -> x-ui -> i.instagram.com   (region check)  -> residential   [tiny, only when needed]
                \> everything else                    -> your normal exit  [free]

Two refresh modes:
  reactive (default, recommended) - a lightweight watcher notices when you're
      actually using Instagram (from x-ui's access log) and refreshes the region
      then, at most once per cooldown. Zero residential traffic when you're not
      using Instagram, and it never "misses" you the way a blind timer can.
  timer - refresh on a fixed schedule (systemd timer), whether or not the app is
      open. Simpler, but can lapse if the window doesn't overlap your usage.

PREREQUISITE
------------
In the x-ui panel add an OUTBOUND:
    Protocol : socks
    Tag      : residental
    Address / Port / user / pass : your residential proxy in a music-enabled country
Then run:  sudo igmusic install

Commands:  check | install | watch | refresh | on | off | status | uninstall
Only the `residental` routing rule is ever touched; the panel version and all your
other routing stay intact. x-ui.db is backed up before structural changes.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

APP = "igmusic"
CONF_DIR = "/etc/igmusic"
CONF = os.path.join(CONF_DIR, "config.json")
BACKUPS = os.path.join(CONF_DIR, "backups")
STATE = "/var/lib/igmusic/last_refresh"
WATCH_LOG = "/var/log/igmusic-watch.log"
SVC_REFRESH = "/etc/systemd/system/igmusic-refresh.service"
TIMER = "/etc/systemd/system/igmusic-refresh.timer"
SVC_WATCH = "/etc/systemd/system/igmusic-watch.service"
TEMPLATE_KEY = "xrayTemplateConfig"

DEFAULTS = {
    "xui_db": "",                       # auto-detected when empty
    "outbound_tag": "residental",
    "hosts": ["full:i.instagram.com"],  # the region-check API; keep it minimal to save data
    "mode": "reactive",                 # reactive | timer
    "cooldown_min": 90,                 # reactive: min minutes between refreshes
    "interval_min": 90,                 # timer: minutes between refreshes
    "window_sec": 180,                  # both: seconds the route stays on per refresh
    "access_log": "",                   # reactive: auto-detected when empty
}

# ------------------------------------------------------------------ output --
_TTY = sys.stdout.isatty()
def _c(code, s): return f"\033[{code}m{s}\033[0m" if _TTY else s
def ok(s):   print(_c("32", "[ok] ") + s)
def info(s): print(_c("36", "[*]  ") + s)
def warn(s): print(_c("33", "[!]  ") + s)
def err(s):  print(_c("31", "[x]  ") + s, file=sys.stderr)
def die(s, code=1): err(s); sys.exit(code)


def need_root():
    if os.geteuid() != 0:
        die("run as root (sudo igmusic ...)")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def wlog(msg):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + msg
    try:
        open(WATCH_LOG, "a").write(line + "\n")
    except Exception:
        pass


# ----------------------------------------------------------- x-ui plumbing --
def find_db(cfg):
    if cfg.get("xui_db") and os.path.exists(cfg["xui_db"]):
        return cfg["xui_db"]
    for p in ("/etc/x-ui/x-ui.db", "/usr/local/x-ui/x-ui.db", "/opt/x-ui/x-ui.db"):
        if os.path.exists(p):
            return p
    die("x-ui database not found (looked in /etc/x-ui, /usr/local/x-ui). Is x-ui installed?")


def find_xray():
    for p in ("/usr/local/x-ui/bin/xray-linux-amd64", "/usr/local/x-ui/bin/xray"):
        if os.path.exists(p):
            return p
    hits = glob.glob("/usr/local/x-ui/bin/xray*")
    return hits[0] if hits else None


def running_config():
    for p in ("/usr/local/x-ui/bin/config.json", "/usr/local/x-ui/config.json"):
        if os.path.exists(p):
            return p
    return None


def access_log_path(cfg):
    if cfg.get("access_log"):
        return cfg["access_log"]
    rc = running_config()
    if rc:
        try:
            acc = json.load(open(rc)).get("log", {}).get("access", "")
            if acc and acc not in ("none", "None"):
                return acc if acc.startswith("/") else os.path.normpath(os.path.join("/usr/local/x-ui", acc))
        except Exception:
            pass
    return "/usr/local/x-ui/access.log"


def load_config():
    cfg = dict(DEFAULTS)
    if os.path.exists(CONF):
        try:
            cfg.update(json.load(open(CONF)))
        except Exception:
            warn(f"{CONF} unreadable, using defaults")
    cfg["xui_db"] = find_db(cfg)
    return cfg


def save_config(cfg):
    os.makedirs(CONF_DIR, exist_ok=True)
    os.chmod(CONF_DIR, 0o700)
    json.dump(cfg, open(CONF, "w"), indent=2)


def backup_db(db):
    os.makedirs(BACKUPS, exist_ok=True)
    os.chmod(BACKUPS, 0o700)
    dst = os.path.join(BACKUPS, "x-ui-%s.db" % time.strftime("%Y%m%d-%H%M%S"))
    s = sqlite3.connect(db); d = sqlite3.connect(dst); s.backup(d); d.close(); s.close()
    for old in sorted(glob.glob(os.path.join(BACKUPS, "x-ui-*.db")))[:-10]:
        os.remove(old)
    return dst


def read_template(db):
    con = sqlite3.connect(db)
    row = con.execute("SELECT value FROM settings WHERE key=?", (TEMPLATE_KEY,)).fetchone()
    con.close()
    if not row:
        die("this x-ui has no xrayTemplateConfig (unexpected panel build)")
    return json.loads(row[0])


def write_template(db, tpl):
    con = sqlite3.connect(db)
    con.execute("UPDATE settings SET value=? WHERE key=?",
                (json.dumps(tpl, ensure_ascii=False), TEMPLATE_KEY))
    con.commit(); con.close()


def get_outbound(tpl, tag):
    return next((o for o in tpl.get("outbounds", []) if o.get("tag") == tag), None)


def restart_xui():
    run(["systemctl", "restart", "x-ui"])
    for _ in range(40):
        if run(["pgrep", "-f", "xray-linux-amd64 -c"]).returncode == 0:
            break
        time.sleep(1)
    time.sleep(2)


def set_route(cfg, on: bool, backup=True):
    """Add or remove the single `residental` routing rule; leave everything else intact."""
    db = cfg["xui_db"]; tag = cfg["outbound_tag"]
    tpl = read_template(db)
    if not get_outbound(tpl, tag):
        die(f"no outbound tagged '{tag}' in the panel. Add a SOCKS outbound with that tag first "
            f"(see `igmusic check`).")
    rules = [r for r in tpl["routing"].get("rules", []) if r.get("outboundTag") != tag]
    if on:
        rules.insert(0, {"type": "field", "outboundTag": tag, "domain": list(cfg["hosts"])})
    tpl["routing"]["rules"] = rules
    if backup:
        backup_db(db)
    write_template(db, tpl)
    restart_xui()


def route_is_on(cfg):
    rc = running_config()
    if not rc:
        return None
    try:
        d = json.load(open(rc))
    except Exception:
        return None
    return any(r.get("outboundTag") == cfg["outbound_tag"] for r in d.get("routing", {}).get("rules", []))


def ensure_access_log(cfg):
    """Reactive mode needs x-ui's Xray access log. Turn it on if it's disabled."""
    db = cfg["xui_db"]
    tpl = read_template(db)
    acc = (tpl.get("log") or {}).get("access", "")
    if acc and acc not in ("none", "None"):
        return
    tpl.setdefault("log", {})["access"] = "./access.log"
    backup_db(db)
    write_template(db, tpl)
    info("enabled Xray access log (required for reactive mode)")


# ------------------------------------------------------------ refresh core --
def last_refresh():
    try:
        return float(open(STATE).read().strip())
    except Exception:
        return 0.0


def mark(ts=None):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    open(STATE, "w").write(str(ts if ts is not None else time.time()))


def do_refresh(cfg):
    mark()  # mark first so buffered activity doesn't re-trigger mid-cycle
    wlog("instagram activity -> refreshing region (residential ON)")
    set_route(cfg, True, backup=False)
    time.sleep(int(cfg["window_sec"]))
    set_route(cfg, False, backup=False)
    mark()
    wlog("region refreshed (residential OFF)")


# ------------------------------------------------------- residential check --
DATACENTER_HINTS = ("datacamp", "m247", "ovh", "hetzner", "amazon", "aws", "google",
                    "cloud", "digitalocean", "linode", "vultr", "leaseweb", "contabo",
                    "choopa", "hosting", "server", "colo")
MUSIC_COUNTRIES = {"US", "GB", "DE", "FR", "IT", "ES", "NL", "SE", "CA", "AU", "BR", "MX",
                   "JP", "KR", "IN", "TR", "AE", "SA", "PL", "PT", "IE", "BE", "AT", "CH",
                   "DK", "NO", "FI"}


def check_proxy(cfg):
    db = cfg["xui_db"]; tag = cfg["outbound_tag"]
    xray = find_xray()
    if not xray:
        warn("xray binary not found; skipping live proxy test")
        return None
    out = get_outbound(read_template(db), tag)
    if not out:
        return None
    W = tempfile.mkdtemp(prefix="igmusic-chk-")
    try:
        conf = {"log": {"loglevel": "warning"},
                "inbounds": [{"listen": "127.0.0.1", "port": 13939, "protocol": "socks",
                              "settings": {"udp": True}}],
                "outbounds": [dict(out, tag="out")]}
        cf = os.path.join(W, "c.json"); json.dump(conf, open(cf, "w"))
        p = subprocess.Popen([xray, "run", "-c", cf],
                             env=dict(os.environ, XRAY_LOCATION_ASSET="/usr/local/x-ui/bin"),
                             stdout=open(os.path.join(W, "log"), "w"), stderr=subprocess.STDOUT)
        time.sleep(4)
        def curl(url, extra=None, tmo="20"):
            return run(["curl", "-s", "-m", tmo, "--socks5-hostname", "127.0.0.1:13939"]
                       + (extra or []) + [url]).stdout
        ipinfo = curl("https://ipinfo.io/json")
        ig = curl("https://i.instagram.com/", ["-o", "/dev/null", "-w", "%{http_code}"], "15")
        p.terminate(); p.wait()
        try:
            j = json.loads(ipinfo)
        except Exception:
            return {"ok": False}
        org = (j.get("org") or "").lower()
        return {"ok": bool(j.get("ip")), "ip": j.get("ip"), "country": j.get("country"),
                "org": j.get("org"), "datacenter": any(h in org for h in DATACENTER_HINTS),
                "music_country": (j.get("country") or "").upper() in MUSIC_COUNTRIES,
                "ig_reachable": ig in ("200", "302", "400", "404")}
    finally:
        shutil.rmtree(W, ignore_errors=True)


# --------------------------------------------------------------- commands ---
def cmd_check(cfg, _):
    info(f"x-ui database : {cfg['xui_db']}")
    out = get_outbound(read_template(cfg["xui_db"]), cfg["outbound_tag"])
    if not out:
        err(f"no outbound tagged '{cfg['outbound_tag']}' found.")
        print("\n  Add it in the x-ui panel:")
        print("    Xray Settings -> Outbounds -> + -> Protocol: socks")
        print(f"    Tag: {cfg['outbound_tag']}")
        print("    Address / Port / Username / Password: your RESIDENTIAL proxy")
        print("  then run `igmusic check` again.\n")
        sys.exit(2)
    ok(f"found outbound '{cfg['outbound_tag']}' (protocol {out.get('protocol')})")
    info("testing the residential proxy (egress) ...")
    r = check_proxy(cfg)
    if not r or not r.get("ok"):
        die("could not reach the internet through the residential outbound - check its credentials.")
    line = f"egress {r['ip']}  country={r['country']}  org={r['org']}"
    ok(line) if r["ig_reachable"] else warn(line)
    (warn if r["datacenter"] else ok)(
        "this looks like a DATACENTER IP - Instagram may still hide music."
        if r["datacenter"] else "looks residential (not an obvious datacenter ASN)")
    (ok if r["music_country"] else warn)(
        f"{r['country']} is a music-licensed region" if r["music_country"]
        else f"country {r['country']} may not have Instagram music - pick US/GB/DE/...")
    print()
    info("ready. run `sudo igmusic install` to enable automatic activation.")


def _write_units(cfg):
    for f in (SVC_REFRESH, TIMER, SVC_WATCH):
        if os.path.exists(f):
            os.remove(f)
    if cfg["mode"] == "reactive":
        open(SVC_WATCH, "w").write(
            "[Unit]\nDescription=Instagram music reactive region refresh (igmusic watch)\n"
            "After=x-ui.service\nWants=x-ui.service\n\n"
            "[Service]\nType=simple\nExecStart=/usr/local/sbin/igmusic watch\n"
            "Restart=always\nRestartSec=5\n\n"
            "[Install]\nWantedBy=multi-user.target\n")
    else:
        open(SVC_REFRESH, "w").write(
            "[Unit]\nDescription=Instagram music region refresh (igmusic)\n"
            "After=x-ui.service\nWants=x-ui.service\n\n"
            "[Service]\nType=oneshot\nExecStart=/usr/local/sbin/igmusic refresh\n"
            "TimeoutStartSec=900\n")
        open(TIMER, "w").write(
            "[Unit]\nDescription=Run igmusic Instagram-music refresh every %d min\n\n" % int(cfg["interval_min"]) +
            "[Timer]\nOnBootSec=3min\nOnUnitActiveSec=%dmin\n" % int(cfg["interval_min"]) +
            "AccuracySec=1min\nPersistent=true\n\n[Install]\nWantedBy=timers.target\n")


def cmd_install(cfg, args):
    need_root()
    if args.mode:     cfg["mode"] = args.mode
    if args.cooldown: cfg["cooldown_min"] = args.cooldown
    if args.interval: cfg["interval_min"] = args.interval
    if args.window:   cfg["window_sec"] = args.window
    if args.tag:      cfg["outbound_tag"] = args.tag
    if cfg["mode"] not in ("reactive", "timer"):
        die("--mode must be 'reactive' or 'timer'")
    if not get_outbound(read_template(cfg["xui_db"]), cfg["outbound_tag"]):
        die(f"no outbound tagged '{cfg['outbound_tag']}'. Add it in the panel first (`igmusic check`).")
    if cfg["mode"] == "reactive":
        ensure_access_log(cfg)
        cfg["access_log"] = access_log_path(cfg)
    save_config(cfg)
    _write_units(cfg)
    mark(0)  # arm: refresh on the next Instagram activity / first timer fire
    run(["systemctl", "daemon-reload"])
    if cfg["mode"] == "reactive":
        run(["systemctl", "enable", "--now", "igmusic-watch.service"])
        ok(f"installed in REACTIVE mode: refresh when you use Instagram, at most every "
           f"{cfg['cooldown_min']} min, {cfg['window_sec']}s window.")
    else:
        run(["systemctl", "enable", "--now", "igmusic-refresh.timer"])
        ok(f"installed in TIMER mode: refresh every {cfg['interval_min']} min, {cfg['window_sec']}s window.")
    info("doing a first activation now ...")
    do_refresh(cfg)
    ok("done. open Instagram (close & reopen) - the Music sticker should be back.")


def cmd_watch(cfg, _):
    """Reactive daemon: refresh the region when Instagram activity is seen, honoring cooldown."""
    need_root()
    access = access_log_path(cfg)
    trigger = cfg["hosts"][0].split(":")[-1]  # e.g. i.instagram.com
    cooldown = int(cfg["cooldown_min"]) * 60
    while not os.path.exists(access):
        time.sleep(5)
    wlog(f"watcher started (cooldown {cfg['cooldown_min']}m, window {cfg['window_sec']}s, log {access})")
    p = subprocess.Popen(["tail", "-F", "-n", "0", access], stdout=subprocess.PIPE, text=True)
    for line in p.stdout:
        if trigger in line and (time.time() - last_refresh() >= cooldown):
            do_refresh(cfg)


def cmd_refresh(cfg, _):
    need_root()
    info("region refresh: routing %s through '%s' ..." % (", ".join(cfg["hosts"]), cfg["outbound_tag"]))
    do_refresh(cfg)
    ok("refresh cycle complete (residential route off again).")


def cmd_on(cfg, _):
    need_root(); set_route(cfg, True)
    ok(f"'{cfg['outbound_tag']}' route ON for {', '.join(cfg['hosts'])} (until `igmusic off`).")


def cmd_off(cfg, _):
    need_root(); set_route(cfg, False)
    ok("residential route OFF (all Instagram on the normal exit).")


def _residential_bytes(cfg):
    rc = running_config(); xray = find_xray()
    if not rc or not xray:
        return None
    try:
        port = next(i for i in json.load(open(rc))["inbounds"] if i.get("tag") == "api")["port"]
    except Exception:
        return None
    out = run([xray, "api", "statsquery", "--server=127.0.0.1:%s" % port, "-pattern", cfg["outbound_tag"]]).stdout
    try:
        return sum(int(s.get("value", 0)) for s in json.loads(out).get("stat", [])
                   if s.get("name", "").startswith("outbound>>>%s>>>" % cfg["outbound_tag"]))
    except Exception:
        return None


def cmd_status(cfg, _):
    on = route_is_on(cfg)
    info("mode              : " + cfg["mode"])
    info("residential route : " + ("ON" if on else "OFF" if on is not None else "unknown"))
    info("outbound / hosts  : %s -> %s" % (cfg["outbound_tag"], ", ".join(cfg["hosts"])))
    if cfg["mode"] == "reactive":
        info("cooldown / window : %s min / %s s" % (cfg["cooldown_min"], cfg["window_sec"]))
        info("watcher           : " + run(["systemctl", "is-active", "igmusic-watch.service"]).stdout.strip())
        lr = last_refresh()
        info("last refresh      : " + (time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(lr)) if lr else "never"))
    else:
        info("interval / window : %s min / %s s" % (cfg["interval_min"], cfg["window_sec"]))
        info("refresh timer     : " + run(["systemctl", "is-active", "igmusic-refresh.timer"]).stdout.strip())
    b = _residential_bytes(cfg)
    if b is not None:
        info("residential used  : %.1f MB (since last xray restart)" % (b / 1048576))


def cmd_uninstall(cfg, _):
    need_root()
    run(["systemctl", "disable", "--now", "igmusic-watch.service"])
    run(["systemctl", "disable", "--now", "igmusic-refresh.timer"])
    for f in (SVC_WATCH, SVC_REFRESH, TIMER):
        if os.path.exists(f):
            os.remove(f)
    run(["systemctl", "daemon-reload"])
    set_route(cfg, False)
    ok("uninstalled: timers/watcher removed, residential route off, Instagram on the normal exit.")
    info("your `residental` outbound and x-ui config are untouched. Backups kept in " + BACKUPS)


def main():
    ap = argparse.ArgumentParser(prog=APP, description="Instagram Music Activation for x-ui panel")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("check", help="verify x-ui + the residential outbound, test its egress")
    pi = sub.add_parser("install", help="enable automatic activation")
    pi.add_argument("--mode", choices=["reactive", "timer"], help="reactive (default) or timer")
    pi.add_argument("--cooldown", type=int, help="reactive: min minutes between refreshes (default 90)")
    pi.add_argument("--interval", type=int, help="timer: minutes between refreshes (default 90)")
    pi.add_argument("--window", type=int, help="seconds the route stays on per refresh (default 180)")
    pi.add_argument("--tag", help="outbound tag to use (default: residental)")
    sub.add_parser("watch", help="reactive daemon (run by the systemd service)")
    sub.add_parser("refresh", help="run one refresh cycle now")
    sub.add_parser("on", help="route Instagram API through residential and leave it on")
    sub.add_parser("off", help="send Instagram back to the normal exit")
    sub.add_parser("status", help="show mode/route/usage")
    sub.add_parser("uninstall", help="remove the watcher/timer and turn the route off")
    args = ap.parse_args()
    if not args.cmd:
        ap.print_help(); sys.exit(0)
    cfg = load_config()
    {"check": cmd_check, "install": cmd_install, "watch": cmd_watch, "refresh": cmd_refresh,
     "on": cmd_on, "off": cmd_off, "status": cmd_status, "uninstall": cmd_uninstall}[args.cmd](cfg, args)


if __name__ == "__main__":
    main()
